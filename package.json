{
  "name": "policyoffice",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm --filter @policyoffice/domain build && pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm invariants && pnpm test && pnpm build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:tenant-isolation": "vitest run --project integration packages/db/src/tenant-isolation.int.test.ts",
    "test:audit-events": "vitest run --project unit tooling/audit-event-completeness.test.ts",
    "test:property": "vitest run --project property",
    "invariants": "tsx tooling/invariant-coverage.ts",
    "db:verify": "pnpm --filter @policyoffice/db verify:fresh && pnpm --filter @policyoffice/db verify:upgrade && pnpm --filter @policyoffice/db verify:drift"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
