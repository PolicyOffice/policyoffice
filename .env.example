# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- Local Postgres (docker compose) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policyoffice
POSTGRES_PORT=5432

# The application connects as a restricted, non-owner role — never as the
# superuser. See ADR-0001 and ADR-0009.
DATABASE_URL=postgres://app_role:app_role@localhost:5432/policyoffice
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/policyoffice

# --- Object storage (MinIO locally, S3-compatible in production) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=policyoffice-local
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Mail (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Neon (platform verification only; never used by the application) ---
# Both are required by verification/neon.sh, because two of its checks are
# specifically about the difference between them. Copy from the Neon console's
# Connect dialog: once with "Connection pooling" ON, once with it OFF.
#
# QUOTE THE VALUES. They contain ? and &, and an unquoted & backgrounds the
# command when the file is sourced.
NEON_DATABASE_URL_POOLED="postgres://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL_DIRECT="postgres://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
